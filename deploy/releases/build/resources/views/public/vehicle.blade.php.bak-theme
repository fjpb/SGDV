<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Consulta Pública SGDV</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Inter,Arial,sans-serif;
}


body{

    background:#f1f5f9;

    min-height:100vh;

    display:flex;

    justify-content:center;

    align-items:center;

    padding:20px;

}



.sgdv-card{

    width:100%;

    max-width:520px;

    background:white;

    border-radius:28px;

    padding:28px;

    box-shadow:0 15px 45px rgba(15,23,42,.12);

}



.header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:25px;

}



.brand{

    display:flex;

    align-items:center;

    gap:12px;

}



.brand-icon{

    width:48px;

    height:48px;

    border-radius:14px;

    background:#2563eb;

    color:white;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:22px;

}



.brand h1{

    font-size:22px;

    color:#0f172a;

}



.brand small{

    color:#64748b;

}



.qr-badge{

    background:#eff6ff;

    color:#2563eb;

    padding:8px 14px;

    border-radius:20px;

    font-size:13px;

    font-weight:600;

}



.vehicle{

    background:#f8fafc;

    border-radius:20px;

    padding:22px;

    margin-bottom:20px;

}



.vehicle h2{

    color:#0f172a;

    font-size:25px;

}



.vehicle .plate{

    margin-top:8px;

    font-size:20px;

    font-weight:700;

    color:#2563eb;

}



.vehicle-info{

    margin-top:15px;

    display:flex;

    justify-content:space-between;

    color:#64748b;

    font-size:14px;

}



.status{

    border-radius:20px;

    padding:22px;

    background:#f8fafc;

    margin-bottom:20px;

}



.percent{

    font-size:42px;

    font-weight:800;

    color:#0f172a;

}



.good{

    background:#dcfce7;

    color:#15803d;

    padding:8px 14px;

    border-radius:20px;

    font-weight:600;

}



.document{

    background:#f8fafc;

    border-radius:18px;

    padding:16px;

    margin-bottom:12px;

    display:flex;

    justify-content:space-between;

    align-items:center;

}



.document-name{

    font-weight:600;

    color:#0f172a;

}



.date{

    font-size:12px;

    color:#64748b;

    margin-top:5px;

}



.state-ok{

    color:#15803d;

}



.state-warning{

    color:#b45309;

}



.state-bad{

    color:#b91c1c;

}



.pdf{

    background:#2563eb;

    color:white;

    padding:8px 14px;

    border-radius:12px;

    text-decoration:none;

    font-size:13px;

}



.footer{

    margin-top:25px;

    text-align:center;

    font-size:13px;

    color:#94a3b8;

}


</style>

</head>


<body>


<div class="sgdv-card">


<div class="header">


<div class="brand">

<div class="brand-icon">

<i class="fa-solid fa-car"></i>

</div>


<div>

<h1>SGDV</h1>

<small>Consulta pública vehicular</small>

</div>


</div>


<div class="qr-badge">

<i class="fa-solid fa-qrcode"></i>

QR

</div>


</div>



<div class="vehicle">


<h2>

{{ $vehicle->marca }}

{{ $vehicle->modelo }}

</h2>


<div class="plate">

{{ $vehicle->patente }}

</div>


<div class="vehicle-info">

<span>

Año: {{ $vehicle->anio }}

</span>


<span>

{{ $vehicle->color }}

</span>


</div>


</div>



@php

$porcentaje = $vehicle->porcentajeDocumentacion();

@endphp



<div class="status">


<div style="display:flex;justify-content:space-between;align-items:center">


<div class="percent">

{{ $porcentaje }}%

</div>


<div class="good">

<i class="fa-solid fa-circle-check"></i>

Vigente

</div>


</div>


<p style="margin-top:10px;color:#64748b">

{{ $vehicle->documentosVigentes() }}

de

{{ $vehicle->totalDocumentos() }}

documentos vigentes

</p>


</div>



@php

$documentosOrdenados = $vehicle->documents->sortBy(function($document){

return match($document->estadoActual()) {

'Vencido'=>1,

'Por vencer'=>2,

'Vigente'=>3,

default=>4

};

});

@endphp



@foreach($documentosOrdenados as $document)


<div class="document">


<div>

<div class="document-name">

<i class="fa-solid fa-file-lines"></i>

{{ $document->tipo_documento ?? $document->nombre }}

</div>


<div class="date">

@if($document->fecha_vencimiento)

Vence:

{{ $document->fecha_vencimiento->format('d-m-Y') }}

@endif

</div>


<div>

@if($document->estadoActual() == 'Vigente')

<span class="state-ok">

<i class="fa-solid fa-check"></i>

Vigente

</span>


@elseif($document->estadoActual() == 'Por vencer')

<span class="state-warning">

<i class="fa-solid fa-triangle-exclamation"></i>

Por vencer

</span>


@else

<span class="state-bad">

<i class="fa-solid fa-circle-xmark"></i>

Vencido

</span>

@endif

</div>


</div>



<a class="pdf"
href="{{ route('public.document',$document->uuid) }}"
target="_blank">

<i class="fa-solid fa-file-pdf"></i>

PDF

</a>


</div>


@endforeach



<div class="footer">

<i class="fa-solid fa-shield-halved"></i>

Información vigente al momento de la consulta

<br>

Sistema SGDV

</div>


</div>


</body>

</html>
