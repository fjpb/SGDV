    /**
     * --------------------------------------------------------------------------
     * Formulario para editar un documento existente.
     * --------------------------------------------------------------------------
     */
    public function edit(
        Document $document
    )
    {

        $this->authorizeDocument(
            $document
        );


        $documentTypes = \App\Models\DocumentType::where(
            'activo',
            true
        )
        ->orderBy('nombre')
        ->get();


        return view(
            'documents.edit',
            compact(
                'document',
                'documentTypes'
            )
        );

    }




    /**
     * --------------------------------------------------------------------------
     * Muestra la ficha del documento.
     * --------------------------------------------------------------------------
     */
    public function show(
        Document $document
    )
    {

        $this->authorizeDocument(
            $document
        );

        return view(
            'documents.show',
            compact('document')
        );

    }


    /**
     * --------------------------------------------------------------------------
     * Descarga el archivo físico del documento.
     * --------------------------------------------------------------------------
     */
    public function download(
        Document $document
    )
    {

        $this->authorizeDocument(
            $document
        );

        return Storage::disk('public')
            ->download(
                $document->archivo
            );

    }


    /**
     * --------------------------------------------------------------------------
     * Elimina un documento.
     * --------------------------------------------------------------------------
     */
    public function destroy(
        Document $document
    )
    {

        $this->authorizeDocument(
            $document
        );

        /*
        |--------------------------------------------------------------------------
        | Elimina el archivo físico
        |--------------------------------------------------------------------------
        */
        Storage::disk('public')
            ->delete(
                $document->archivo
            );

        /*
        |--------------------------------------------------------------------------
        | Elimina el registro
        |--------------------------------------------------------------------------
        */
        $document->delete();

        return redirect()

            ->route('documents.index')

            ->with(
                'success',
                'Documento eliminado correctamente.'
            );

    }


    /**
     * --------------------------------------------------------------------------
     * Lista los documentos asociados a un vehículo.
     * --------------------------------------------------------------------------
     */
    public function vehicleDocuments(
        $vehicle
    )
    {

        $documents = Document::where(
            'vehicle_id',
            $vehicle
        )
        ->get();

        return view(
            'documents.vehicle',
            compact('documents')
        );

    }


    /**
     * --------------------------------------------------------------------------
     * Verifica que el documento pertenezca al usuario autenticado.
     * --------------------------------------------------------------------------
     */
    private function authorizeDocument(
        Document $document
    )
    {

        if (
            $document
                ->vehicle
                ->user_id
            !== Auth::id()
        ) {

            abort(403);

        }

    }

}