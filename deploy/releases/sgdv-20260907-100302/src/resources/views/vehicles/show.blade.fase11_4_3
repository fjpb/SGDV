                    @php

                        $proximos = $vehicle->documents
                            ->filter(function($document){

                                return $document->diasRestantes() !== null
                                    && $document->diasRestantes() <= 60;

                            })
                            ->sortBy('fecha_vencimiento')
                            ->take(5);

                    @endphp



                    @if($proximos->count())


                        <div class="list-group list-group-flush">


