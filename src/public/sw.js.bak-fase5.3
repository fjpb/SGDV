const CACHE_NAME = 'sgdv-offline-v1';

const DB_NAME = 'sgdv-offline';
const DB_VERSION = 1;
const STORE_NAME = 'documents';


self.addEventListener('install', event => {

    self.skipWaiting();

});


self.addEventListener('activate', event => {

    event.waitUntil(clients.claim());

});


self.addEventListener('fetch', event => {

    if (event.request.method !== 'GET') {
        return;
    }


    const url = new URL(event.request.url);


    if (url.pathname.startsWith('/consulta/documento/')) {

        event.respondWith(
            handleDocument(event.request)
        );

    }

});



async function handleDocument(request)
{

    const cache = await caches.open(CACHE_NAME);


    try {

        const response = await fetch(request);


        if (response.ok) {


            const keys = await cache.keys();


            for (const key of keys) {

                await cache.delete(key);

            }


            await cache.put(
                request,
                response.clone()
            );


            await saveMetadata(request.url);


        }


        return response;


    } catch(error) {


        const cached = await cache.match(request);


        if (cached) {


            const metadata = await getMetadata();


            return addOfflineHeaders(
                cached,
                metadata
            );


        }


        return offlineResponse();

    }

}




function openDatabase()
{

    return new Promise((resolve,reject)=>{


        const request =
            indexedDB.open(
                DB_NAME,
                DB_VERSION
            );


        request.onupgradeneeded = () => {

            const db = request.result;


            if (!db.objectStoreNames.contains(STORE_NAME)) {

                db.createObjectStore(
                    STORE_NAME,
                    {
                        keyPath:'id'
                    }
                );

            }

        };


        request.onsuccess = () =>
            resolve(request.result);


        request.onerror = () =>
            reject(request.error);


    });

}



async function saveMetadata(url)
{

    const db = await openDatabase();


    const tx =
        db.transaction(
            STORE_NAME,
            'readwrite'
        );


    tx.objectStore(STORE_NAME)
        .put({

            id:'last-document',

            url:url,

            synced_at:
                new Date().toISOString()

        });


}



async function getMetadata()
{

    const db = await openDatabase();


    return new Promise(resolve=>{


        const tx =
            db.transaction(
                STORE_NAME,
                'readonly'
            );


        const request =
            tx.objectStore(STORE_NAME)
            .get(
                'last-document'
            );


        request.onsuccess = () =>
            resolve(request.result);


        request.onerror = () =>
            resolve(null);


    });


}



function addOfflineHeaders(
    response,
    metadata
)
{

    const headers =
        new Headers(
            response.headers
        );


    headers.set(
        'X-SGDV-Offline',
        'true'
    );


    if(metadata){

        headers.set(
            'X-SGDV-Sync-Date',
            metadata.synced_at
        );

    }


    return new Response(
        response.body,
        {
            status:response.status,
            statusText:response.statusText,
            headers:headers
        }
    );

}



function offlineResponse()
{

    return new Response(

        `
        <html>
        <body style="font-family:Arial;padding:40px">

        <h2>Sin conexión</h2>

        <p>
        Este documento nunca fue sincronizado.
        </p>

        </body>
        </html>
        `,

        {
            status:503,
            headers:{
                'Content-Type':'text/html'
            }
        }

    );

}
