<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>
Tarjeta SGDV
</title>


<style>

*{
box-sizing:border-box;
}


body{

margin:0;

background:#eef2f7;

font-family:Arial, Helvetica, sans-serif;

min-height:100vh;

display:flex;

justify-content:center;

align-items:center;

padding:30px;

}



.card{

width:420px;

background:white;

border-radius:28px;

padding:35px;

box-shadow:0 15px 40px rgba(0,0,0,.12);

}



.header{

display:flex;

justify-content:space-between;

align-items:center;

}



.logo{

font-size:32px;

font-weight:800;

color:#2563eb;

}



.subtitle{

font-size:13px;

color:#64748b;

}



.verify{

font-size:20px;

color:#16a34a;

}



.vehicle{

margin-top:25px;

background:#f8fafc;

border-radius:20px;

padding:20px;

}



.vehicle h2{

margin:0;

color:#0f172a;

font-size:25px;

}



.patente{

font-size:28px;

font-weight:bold;

letter-spacing:3px;

margin-top:10px;

}



.data{

margin-top:8px;

color:#64748b;

}



.status{

margin-top:20px;

padding:18px;

border-radius:18px;

background:#dcfce7;

color:#166534;

text-align:center;

}



.percent{

font-size:40px;

font-weight:bold;

}



.docs{

margin-top:8px;

}



.qr{

text-align:center;

margin-top:25px;

}



.qr svg{

width:220px;

height:220px;

}



.footer{

text-align:center;

margin-top:20px;

font-size:13px;

color:#64748b;

}



.print{

text-align:center;

margin-top:25px;

}



.print button{

background:#2563eb;

color:white;

border:0;

padding:12px 25px;

border-radius:10px;

cursor:pointer;

}



@media print{


body{

background:white;

}


.card{

box-shadow:none;

}


.print{

display:none;

}

}


</style>

</head>


<body>


<div>


<div class="card">


<div class="header">


<div>

<div class="logo">
SGDV
</div>


<div class="subtitle">
Sistema Gestión Documental Vehicular
</div>


</div>


<div class="verify">

✓

</div>


</div>




<div class="vehicle">


<h2>

{{ $vehicle->marca }}

{{ $vehicle->modelo }}

</h2>


<div class="patente">

{{ $vehicle->patente }}

</div>


<div class="data">

Año {{ $vehicle->anio }}

|

{{ $vehicle->color }}

</div>


</div>




<div class="status">


<div class="percent">

{{ $cumplimiento }}%

</div>


<div>

{{ $estadoGeneral }}

</div>


<div class="docs">

{{ $vigentes }}

de

{{ $totalDocumentos }}

documentos vigentes

</div>


</div>



<div class="qr">

{!! $qr !!}

</div>



<div class="footer">


Escanee el QR para validar documentación


<br>


Generado:

{{ $fechaGeneracion }}


</div>



</div>



<div class="print">


<button onclick="window.print()">

🖨 Imprimir tarjeta

</button>


</div>


</div>


</body>


</html>
